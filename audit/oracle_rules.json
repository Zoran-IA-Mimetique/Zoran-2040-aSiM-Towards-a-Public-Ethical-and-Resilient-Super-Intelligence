  "blocking_rules": [
    {
      "id": "R-DEN-1",
      "name": "Hard density limit",
      "condition": "links / nodes > thresholds.density_hard",
      "action": "reject",
      "severity": "critical",
      "doc": "audit/CHAOS_PREVENTION.md §3-D1"
    },
    {
      "id": "R-INV-1",
      "name": "Iso requires invariants",
      "condition": "edge.kind == 'iso' AND (edge.invariants == null OR len(edge.invariants) == 0)",
      "action": "reject",
      "severity": "critical",
      "doc": "audit/EDGE_SYSTEM_SPEC.md §3 (iso)"
    },
    {
      "id": "R-REC-1",
      "name": "Parent must form DAG",
      "condition": "adding edge.kind=='parent' creates a cycle",
      "action": "reject",
      "severity": "critical",
      "doc": "audit/edge_types.json (parent.constraints.must_form_dag)"
    },
    {
      "id": "R-CTR-1",
      "name": "Contradicts must be reciprocal",
      "condition": "edge.kind == 'contradicts' AND reciprocal not declared",
      "action": "warn_then_auto_repair",
      "severity": "warn",
      "doc": "audit/edge_types.json (contradicts.constraints.requires_reciprocal)"
    },
    {
      "id": "R-MAX-1",
      "name": "Max kinds per pair",
      "condition": "more than 2 kinds between same (source, target)",
      "action": "reject",
      "severity": "critical",
      "doc": "audit/edge_types.json (global_constraints.max_kinds_per_pair)"
    },
    {
      "id": "R-INF-1",
      "name": "Family must be canonical",
      "condition": "node.family not in ['ULG','DVE','UDE','GHUC','WP11','WP12','SDE','PAL']",
      "action": "reject",
      "severity": "critical",
      "doc": "audit/P0_5_ADMISSIBILITY.md §A1"
    },
    {
      "id": "R-WP11-INFERENCE",
      "name": "No automatic inference S_local -> S_global",
