      "action": "reject",
      "severity": "critical",
      "doc": "audit/S_GLOBAL_RULES.md R-S0"
    },
    {
      "id": "R-S2",
      "name": "Proxy tag required",
      "condition": "publish(S_global, scalar=true) AND C_composition < thresholds.compositions_required_for_S_global_scalar / N_attractors_mu0",
      "action": "reject_publication",
      "severity": "critical",
      "doc": "audit/S_GLOBAL_RULES.md R-S2"
    }
