{
  "$comment": "zoran.zce.gap_ledger.v1 — registre des écarts prouvés : raccordements, corrections, absences, guards manquants.",
  "type": "object",
  "required": ["schema", "gaps"],
  "properties": {
    "schema": {"type": "string", "enum": ["zoran.zce.gap_ledger.v1"]},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "kind", "target", "cause"],
        "properties": {
          "gap_id": {"type": "string"},
          "kind": {"type": "string", "enum": ["WIRE", "CORRECT", "MISSING_BRICK", "MISSING_GUARD"]},
          "target": {"type": "string"},
          "cause": {"type": "string"},
          "allowed_paths": {"type": "array", "items": {"type": "string"}},
          "max_diff_lines": {"type": "integer"},
          "acceptance_tests": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "string"},
          "guard_receipt": {
            "type": "object",
            "required": ["path", "content_sha256"],
            "properties": {
              "path": {"type": "string"},
              "content_sha256": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
